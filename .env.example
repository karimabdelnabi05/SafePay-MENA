# SafePay MENA - Environment Variables Example
PROJECT_NAME="SafePay MENA"
USE_MOCK_TELECOM=true

# Nokia Network as Code (RapidAPI)
NOKIA_RAPIDAPI_KEY=your_rapidapi_key_here
NOKIA_API_BASE_URL="https://network-as-code.p.rapidapi.com"

# Google Gemini AI Agent
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Audit Logging)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here
